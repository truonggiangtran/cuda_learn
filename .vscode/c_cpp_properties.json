{
  "version": 4,
  "configurations": [
    {
      "name": "Linux-Docker",
      "includePath": [
        "${workspaceFolder}/source",
        "${workspaceFolder}/source/image_processing",
        "${workspaceFolder}/source/matrix",
        "${workspaceFolder}/source/camera_control",
        "/usr/local/cuda/include",
        "/usr/include/opencv4"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/source",
          "${workspaceFolder}/source/image_processing",
          "${workspaceFolder}/source/matrix",
          "${workspaceFolder}/source/camera_control",
          "/usr/local/cuda/include",
          "/usr/include/opencv4"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "defines": [
        "__CUDACC__"
      ],
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ]
}
